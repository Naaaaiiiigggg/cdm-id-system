rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && myProfile().role == 'admin' && myProfile().status == 'Active';
    }
    function isActiveStudent() {
      return hasProfile() && myProfile().role == 'student' && myProfile().status == 'Active';
    }
    // The ID can only be printed or handed out when the Registrar photo and the student's signature exist.
    function printReady(studentNo) {
      return get(/databases/$(database)/documents/registrar_students/$(studentNo)).data.get('photo', '') != ''
        && exists(/databases/$(database)/documents/student_signatures/$(studentNo));
    }
    function verifiedFor(studentNo) {
      return signedIn()
        && exists(/databases/$(database)/documents/verifications/$(request.auth.uid))
        && get(/databases/$(database)/documents/verifications/$(request.auth.uid)).data.studentNo == studentNo;
    }

    // "I am student 24-66298, born 2006-02-04": allowed only if it matches the Registrar record
    // and nobody has registered that number yet.
    match /verifications/{uid} {
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentNo', 'birthdate', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/registrar_students/$(request.resource.data.studentNo))
        && get(/databases/$(database)/documents/registrar_students/$(request.resource.data.studentNo)).data.birthdate == request.resource.data.birthdate
        && !exists(/databases/$(database)/documents/registered_students/$(request.resource.data.studentNo));
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'status', 'studentNo', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['role', 'status', 'studentNo', 'email', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'Active'
        && request.resource.data.createdAt == request.time
        && verifiedFor(request.resource.data.studentNo)
        && !exists(/databases/$(database)/documents/registered_students/$(request.resource.data.studentNo));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Active', 'Suspended'];
      allow delete: if false;
    }

    match /registrar_students/{studentNo} {
      allow read: if isAdmin()
        || (hasProfile() && myProfile().studentNo == studentNo)
        || verifiedFor(studentNo);
      allow write: if false;
    }

    match /registered_students/{studentNo} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentNo == studentNo;
      allow read, update, delete: if false;
    }

    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isActiveStudent()
        && request.resource.data.keys().hasOnly(['uid', 'studentNo', 'requestNo', 'type', 'reason', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'studentNo', 'requestNo', 'type', 'reason', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentNo == myProfile().studentNo
        && request.resource.data.requestNo == id
        && request.resource.data.status == 'Submitted'
        && request.resource.data.type in ['New ID', 'Replacement']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 60
        && request.resource.data.createdAt == request.time;
      // The Registrar can only change: the stage, the note, the date of each step and the pickup details.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt', 'stageDates', 'pickupDate', 'pickupFrom', 'pickupTo', 'pickupBring'])
        && request.resource.data.status in ['Submitted', 'Under Review', 'Approved', 'For Printing', 'Ready for Pickup', 'Claimed', 'Rejected']
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 200
        && request.resource.data.updatedAt == request.time
        && (!('stageDates' in request.resource.data)
            || (request.resource.data.stageDates is map
                && request.resource.data.stageDates.keys().hasOnly(['Submitted', 'Under Review', 'Approved', 'For Printing', 'Ready for Pickup', 'Claimed', 'Rejected'])))
        && (!('pickupDate' in request.resource.data)
            || (request.resource.data.pickupDate is string && request.resource.data.pickupDate.size() <= 10))
        && (!('pickupFrom' in request.resource.data)
            || (request.resource.data.pickupFrom is string && request.resource.data.pickupFrom.size() <= 5))
        && (!('pickupTo' in request.resource.data)
            || (request.resource.data.pickupTo is string && request.resource.data.pickupTo.size() <= 5))
        && (!('pickupBring' in request.resource.data)
            || (request.resource.data.pickupBring is string && request.resource.data.pickupBring.size() <= 100))
        // Ready for Pickup needs a pickup date written like 2026-11-09
        && (request.resource.data.status != 'Ready for Pickup'
            || ('pickupDate' in request.resource.data && request.resource.data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        // For Printing, Ready for Pickup and Claimed need the photo and the signature
        && (!(request.resource.data.status in ['For Printing', 'Ready for Pickup', 'Claimed'])
            || printReady(resource.data.studentNo));
      allow delete: if false;
    }

    // ---------- student_signatures: drawn by the student in the app, saved ONCE ----------
    // Only the Registrar (through the API) can reset it, so the signature on a printed ID can't be swapped.
    match /student_signatures/{studentNo} {
      allow read: if isAdmin() || (hasProfile() && myProfile().studentNo == studentNo);
      allow create: if isActiveStudent()
        && myProfile().studentNo == studentNo
        && request.resource.data.keys().hasOnly(['path', 'box', 'updatedAt'])
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 20000
        && request.resource.data.box is list
        && request.resource.data.box.size() == 4
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'requestNo', 'message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 600
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'target', 'by', 'byEmail', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
