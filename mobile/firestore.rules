rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && myProfile().role == 'admin' && myProfile().status == 'Active';
    }
    function isActiveStudent() {
      return hasProfile() && myProfile().role == 'student' && myProfile().status == 'Active';
    }
    // The ID can only be printed or handed out when the Registrar photo and the student's signature exist.
    function printReady(studentNo) {
      return get(/databases/$(database)/documents/registrar_students/$(studentNo)).data.get('photo', '') != ''
        && exists(/databases/$(database)/documents/student_signatures/$(studentNo));
    }
    // The ONLY allowed stage changes. Keep it identical to backend/app/core/config.py (ALLOWED_TRANSITIONS)
    // and mobile/src/data/stageRules.js. Staying on the same stage (editing the note or pickup details) is allowed,
    // except on Claimed, which is final. A request only moves forward, and can be rejected only before Approved.
    function validMove(fromStage, toStage) {
      return fromStage != 'Claimed' && (fromStage == toStage
        || (fromStage == 'Submitted' && toStage in ['Under Review', 'Rejected'])
        || (fromStage == 'Under Review' && toStage in ['Approved', 'Rejected'])
        || (fromStage == 'Approved' && toStage == 'For Printing')
        || (fromStage == 'For Printing' && toStage == 'Ready for Pickup')
        || (fromStage == 'Ready for Pickup' && toStage == 'Claimed')
        || (fromStage == 'Rejected' && toStage == 'Under Review'));
    }
    function verifiedFor(studentNo) {
      return signedIn()
        && exists(/databases/$(database)/documents/verifications/$(request.auth.uid))
        && get(/databases/$(database)/documents/verifications/$(request.auth.uid)).data.studentNo == studentNo;
    }

    // Same checks as the backend (schemas.py StudentCreate).
    function validStudent(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.program in ['BSIT', 'BSCPE', 'BSEd-SCI', 'BEEd-GEN', 'BEEd-ECED', 'BTLEd-ICT', 'BSBA-HRM', 'BSE']
        && d.yearLevel in ['1st Year', '2nd Year', '3rd Year', '4th Year']
        && d.birthdate is string && d.birthdate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.contact is string && d.contact.matches('^09[0-9]{9}$')
        && d.address is string && d.address.size() >= 5 && d.address.size() <= 150
        && d.guardian is string && d.guardian.size() >= 2 && d.guardian.size() <= 80
        && d.guardianContact is string && d.guardianContact.matches('^09[0-9]{9}$');
    }

    // "I am student 24-66298, born 2006-02-04": allowed only if it matches the Registrar record
    // and nobody has registered that number yet.
    match /verifications/{uid} {
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentNo', 'birthdate', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/registrar_students/$(request.resource.data.studentNo))
        && get(/databases/$(database)/documents/registrar_students/$(request.resource.data.studentNo)).data.birthdate == request.resource.data.birthdate
        && !exists(/databases/$(database)/documents/registered_students/$(request.resource.data.studentNo));
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'status', 'studentNo', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['role', 'status', 'studentNo', 'email', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'Active'
        && request.resource.data.createdAt == request.time
        && verifiedFor(request.resource.data.studentNo)
        && !exists(/databases/$(database)/documents/registered_students/$(request.resource.data.studentNo));
      // The Registrar can suspend or reactivate an account (and nothing else on it).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'suspendedAt', 'suspendedUntil', 'suspendPermanent', 'suspendReason', 'suspendMessage'])
        && request.resource.data.status in ['Active', 'Suspended']
        && request.resource.data.get('suspendReason', '') is string
        && request.resource.data.get('suspendReason', '').size() <= 100
        && request.resource.data.get('suspendMessage', '') is string
        && request.resource.data.get('suspendMessage', '').size() <= 300
        && (request.resource.data.status == 'Active'
            || (request.resource.data.suspendedAt == request.time
                && request.resource.data.suspendPermanent is bool
                && (request.resource.data.suspendPermanent == true
                    || (request.resource.data.suspendedUntil is timestamp
                        && request.resource.data.suspendedUntil > request.time))));
      // A student whose suspension end date has passed switches their own account back on at sign-in.
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.role == 'student'
        && resource.data.status == 'Suspended'
        && resource.data.get('suspendPermanent', false) == false
        && resource.data.get('suspendedUntil', null) != null
        && resource.data.suspendedUntil <= request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'suspendedAt', 'suspendedUntil', 'suspendPermanent', 'suspendReason', 'suspendMessage'])
        && request.resource.data.status == 'Active'
        && request.resource.data.get('suspendedUntil', null) == null
        && request.resource.data.get('suspendPermanent', false) == false;
      allow delete: if false;
    }

    match /registrar_students/{studentNo} {
      allow read: if isAdmin()
        || (hasProfile() && myProfile().studentNo == studentNo)
        || verifiedFor(studentNo);
      // The Registrar can add, edit and remove students on the list.
      // (The signature is drawn by the student and is not editable here.)
      allow create: if isAdmin()
        && studentNo.matches('^[0-9]{2}-[0-9]{5}$')
        && request.resource.data.keys().hasOnly(['name', 'program', 'yearLevel', 'birthdate', 'contact', 'address', 'guardian', 'guardianContact', 'photo', 'photoUpdatedAt'])
        && request.resource.data.keys().hasAll(['name', 'program', 'yearLevel', 'birthdate', 'contact', 'address', 'guardian', 'guardianContact'])
        && validStudent(request.resource.data)
        // The ID photo (a small JPEG data URI) can be added in the same step. The photo and its time come together.
        && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string
                && request.resource.data.photo.size() <= 700000
                && request.resource.data.photo.matches('data:image/jpeg;base64,.*')
                && request.resource.data.photoUpdatedAt == request.time))
        && (!('photoUpdatedAt' in request.resource.data) || 'photo' in request.resource.data);
      // It can also set or remove the ID photo (a small JPEG data URI) and its upload time.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'program', 'yearLevel', 'birthdate', 'contact', 'address', 'guardian', 'guardianContact', 'photo', 'photoUpdatedAt'])
        && validStudent(request.resource.data)
        && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string
                && request.resource.data.photo.size() <= 700000
                && request.resource.data.photo.matches('data:image/jpeg;base64,.*')))
        && (!('photoUpdatedAt' in request.resource.data)
            || request.resource.data.photoUpdatedAt == request.time
            || request.resource.data.photoUpdatedAt == resource.data.get('photoUpdatedAt', null));
      // Only a student who has no account yet can be removed.
      allow delete: if isAdmin()
        && !exists(/databases/$(database)/documents/registered_students/$(studentNo));
    }

    match /registered_students/{studentNo} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentNo == studentNo;
      allow read, update, delete: if false;
    }

    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isActiveStudent()
        && request.resource.data.keys().hasOnly(['uid', 'studentNo', 'requestNo', 'type', 'reason', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'studentNo', 'requestNo', 'type', 'reason', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentNo == myProfile().studentNo
        && request.resource.data.requestNo == id
        && request.resource.data.status == 'Submitted'
        && request.resource.data.type in ['New ID', 'Replacement']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 60
        && request.resource.data.createdAt == request.time;
      // The Registrar can only change: the stage (see validMove), the note, the date of each step and the pickup details.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt', 'stageDates', 'pickupDate', 'pickupFrom', 'pickupTo', 'pickupBring'])
        && request.resource.data.status in ['Submitted', 'Under Review', 'Approved', 'For Printing', 'Ready for Pickup', 'Claimed', 'Rejected']
        && validMove(resource.data.status, request.resource.data.status)
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 200
        && request.resource.data.updatedAt == request.time
        && (!('stageDates' in request.resource.data)
            || (request.resource.data.stageDates is map
                && request.resource.data.stageDates.keys().hasOnly(['Submitted', 'Under Review', 'Approved', 'For Printing', 'Ready for Pickup', 'Claimed', 'Rejected'])))
        && (!('pickupDate' in request.resource.data)
            || (request.resource.data.pickupDate is string && request.resource.data.pickupDate.size() <= 10))
        && (!('pickupFrom' in request.resource.data)
            || (request.resource.data.pickupFrom is string && request.resource.data.pickupFrom.size() <= 5))
        && (!('pickupTo' in request.resource.data)
            || (request.resource.data.pickupTo is string && request.resource.data.pickupTo.size() <= 5))
        && (!('pickupBring' in request.resource.data)
            || (request.resource.data.pickupBring is string && request.resource.data.pickupBring.size() <= 100))
        // Ready for Pickup needs a pickup date written like 2026-11-09
        && (request.resource.data.status != 'Ready for Pickup'
            || ('pickupDate' in request.resource.data && request.resource.data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        // For Printing, Ready for Pickup and Claimed need the photo and the signature
        && (!(request.resource.data.status in ['For Printing', 'Ready for Pickup', 'Claimed'])
            || printReady(resource.data.studentNo));
      allow delete: if false;
    }

    // ---------- student_signatures: drawn by the student in the app, saved ONCE ----------
    // Only the Registrar (through the API) can reset it, so the signature on a printed ID can't be swapped.
    match /student_signatures/{studentNo} {
      allow read: if isAdmin() || (hasProfile() && myProfile().studentNo == studentNo);
      allow create: if isActiveStudent()
        && myProfile().studentNo == studentNo
        && request.resource.data.keys().hasOnly(['path', 'box', 'updatedAt'])
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 20000
        && request.resource.data.box is list
        && request.resource.data.box.size() == 4
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'requestNo', 'message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 600
        && request.resource.data.createdAt == request.time;
      // A student can only mark their own alert as read (the readAt field, nothing else).
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'target', 'by', 'byEmail', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
